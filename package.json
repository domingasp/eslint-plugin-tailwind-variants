{
  "name": "eslint-plugin-tailwind-variants",
  "version": "2.0.3",
  "description": "ESLint plugin for Tailwind Variants",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "tailwind",
    "tailwind-variants"
  ],
  "license": "MIT",
  "author": "madebydomdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/domingasp/eslint-plugin-tailwind-variants.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "knip": "knip",
    "lint": "oxlint --type-aware",
    "fmt:check": "oxfmt --check",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:debug": "vitest --reporter=verbose",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/css": "^0.14.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/eslint-scope": "^8.4.0",
    "@types/estree": "^1.0.8",
    "@types/estree-jsx": "^1.0.5",
    "@types/node": "^25.2.3",
    "@typescript-eslint/utils": "^8.55.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsdoc": "^62.5.5",
    "husky": "^9.1.7",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.3.0"
  },
  "peerDependencies": {
    "eslint": ">9.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.29.3"
}
