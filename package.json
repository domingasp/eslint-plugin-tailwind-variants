{
  "name": "eslint-plugin-tailwind-variants",
  "version": "2.0.1",
  "description": "ESLint plugin for Tailwind Variants",
  "repository": {
    "type": "git",
    "url": "https://github.com/domingasp/eslint-plugin-tailwind-variants.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:debug": "vitest --reporter=verbose",
    "prepare": "husky"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "tailwind",
    "tailwind-variants"
  ],
  "files": [
    "dist"
  ],
  "author": "madebydomdev",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "eslint": ">9.0.0"
  },
  "dependencies": {
    "@eslint/css": "^0.14.1",
    "@typescript-eslint/utils": "^8.51.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/rule-tester": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.2.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16",
    "vue-eslint-parser": "^10.2.0"
  }
}
